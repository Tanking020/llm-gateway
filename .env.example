# ============================================================
# .env.example —— 配置模板
# 这一份【要提交】进 Git（它是"本项目需要哪些配置"的说明书）
# 真实取值放 .env —— 那一份【不提交】（已在 .gitignore 里）
#
# 用法：复制成 .env，再按需修改
#   Copy-Item .env.example .env
# ============================================================
#
# 书写规则：
#   1. 格式是 键=值，一行一个；# 开头是注释；空行被忽略
#   2. 键名 = config.py 里字段名转大写（APP_NAME ← app_name），匹配时大小写不敏感
#   3. 值不用加引号（加了引号的话，引号本身会变成值的一部分）
#   4. ⚠️ 这里只放【示例/占位值】，绝不放真实密钥

# 与 config.py 看起来一样，是因为"名字必须一一对应"。
# config.py 是函数签名（名字 + 类型 + 默认值），.env 是实参（实际的值）。
# 表头和填好的表格，格子名当然一样，但一个是"定义"，一个是"实例"。

# ============================================================
# ⚠️ 下面是【示例值】，不是"你必须照抄的值"。
#    每一项都写明了「可填什么」，请按自己的需要改。
#    下面给的都是 config.py 里的【默认值】—— 也就是说你可以直接全部删掉，
#    行为完全一样（默认值会自动生效）。
# ============================================================

# 应用名。任意字符串，不要加引号。
APP_NAME=llm-app-engineering

# 运行环境。⚠️ 只能填 dev 或 prod（config.py 里用了 Literal 限制），
# 填别的（如 test）会【直接报错】而不是被忽略。
# ⚠️ 填 prod 时 DEBUG 必须是 false，否则启动报错退出（见下面 DEBUG 那条）
APP_ENV=dev

# 调试开关。可填 true / false / 1 / 0 / yes / no（大小写不敏感），
# pydantic 会把它转成真正的布尔值。
# ⚠️ APP_ENV=prod 且 DEBUG=true 时，config.py 的跨字段校验会让进程【启动即退出】——
#    故意不静默改成 false：配置写错要在启动时炸，不能带着 traceback 泄露上线
DEBUG=false

# 监听地址。127.0.0.1 = 只有本机能访问；0.0.0.0 = 所有网络都能访问（生产常用）。
HOST=127.0.0.1

# 监听端口。可填 1 ~ 65535 的整数。
# 注意：这里是【字符串】形式（.env 里一切都是字符串），
#       但 config.py 声明了 port: int，所以会被自动转成整数 8000。
PORT=8000

# 数据库连接串。格式是「方言+驱动://路径」
#   sqlite+aiosqlite:///./app.db  -> 当前工作目录下的 app.db（相对路径，带三个斜杠）
#   换 PostgreSQL 时形如 postgresql+asyncpg://user:pass@host:5432/dbname
# ⚠️ 真值（尤其带密码的连接串）只放 .env，绝不写进这一份
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ===== 上游 LLM 供应商（OpenAI 兼容协议）=====
# 现在接的是 DeepSeek（https://api-docs.deepseek.com/zh-cn/）。
# 换别家只改下面这三行 + 密钥，代码一行都不用动。

# 上游 LLM 的 API Key
#
# ⚠️ 这里是 .env.example，所以【绝不能】放真实密钥 —— 这份文件要提交进 Git。
#    真正要用时，去 .env 里取消下面这行注释并填上自己的 key。
#
# ⚠️ 一个反直觉的细节：不要写成 `LLM_API_KEY=`（等号后面留空）。
#    实测：`LLM_API_KEY=`  → 得到【空字符串 ''】
#         整行注释掉        → 得到【None】
#    两者在 if settings.llm_api_key: 判断里【都会走 False 分支】，
#    但语义不同（'' 是"我填了个空的"，None 是"我没填"），所以推荐直接注释掉。
# LLM_API_KEY=sk-在这里填你自己的密钥

# 上游基础地址。DeepSeek 用不带 /v1 的地址；有些兼容服务要写 .../v1。
# 末尾不要带斜杠。
LLM_BASE_URL=https://api.deepseek.com

# 默认模型名
LLM_MODEL=deepseek-flash

# 单次上游请求的超时时间（秒），LLM 生成较慢，这里不用 5 秒默认值
REQUEST_TIMEOUT=30
