# ============================================================
# .env.example —— 配置模板
# 这一份【要提交】进 Git（它是"本项目需要哪些配置"的说明书）
# 真实取值放 .env —— 那一份【不提交】（已在 .gitignore 里）
#
# 用法：复制成 .env，再按需修改
#   Copy-Item .env.example .env
# ============================================================
#
# 书写规则：
#   1. 格式是 键=值，一行一个；# 开头是注释；空行被忽略
#   2. 键名 = config.py 里字段名转大写（APP_NAME ← app_name），匹配时大小写不敏感
#   3. 值不用加引号（加了引号的话，引号本身会变成值的一部分）
#   4. ⚠️ 这里只放【示例/占位值】，绝不放真实密钥

# 与 config.py 看起来一样，是因为"名字必须一一对应"。
# config.py 是函数签名（名字 + 类型 + 默认值），.env 是实参（实际的值）。
# 表头和填好的表格，格子名当然一样，但一个是"定义"，一个是"实例"。

# 应用名（对应 config.py 的 app_name: str）
APP_NAME=llm-service

# 运行环境（对应 app_env: Literal["dev", "prod"] —— 只能填 dev 或 prod）
APP_ENV=dev

# 调试开关（对应 debug: bool —— 可填 true / false / 1 / 0）
DEBUG=true

# 监听地址（对应 host: str）
HOST=127.0.0.1

# 监听端口（对应 port: int —— 这里写的是字符串 "9001"，会被自动转成 int 9001）
PORT=9001

# 上游 LLM 的 API Key（对应 openai_api_key: str | None）
# ⚠️ 故意【注释掉】而不是写成 OPENAI_API_KEY=
#    因为"空值"会被当成【空字符串 ''】，而不是 None
#    （实测：OPENAI_API_KEY=  →  openai_api_key=''；注释掉 → openai_api_key=None）
#    将来真要用时，在 .env 里取消注释并填真实 key
# OPENAI_API_KEY=sk-your-key-here