# ============================================================
# .env.example —— 配置模板
# 这一份【要提交】进 Git（它是"本项目需要哪些配置"的说明书）
# 真实取值放 .env —— 那一份【不提交】（已在 .gitignore 里）
#
# 用法：复制成 .env，再按需修改
#   Copy-Item .env.example .env
# ============================================================
#
# 书写规则：
#   1. 格式是 键=值，一行一个；# 开头是注释；空行被忽略
#   2. 键名 = config.py 里字段名转大写（APP_NAME ← app_name），匹配时大小写不敏感
#   3. 值不用加引号（加了引号的话，引号本身会变成值的一部分）
#   4. ⚠️ 这里只放【示例/占位值】，绝不放真实密钥

# 与 config.py 看起来一样，是因为"名字必须一一对应"。
# config.py 是函数签名（名字 + 类型 + 默认值），.env 是实参（实际的值）。
# 表头和填好的表格，格子名当然一样，但一个是"定义"，一个是"实例"。

# ============================================================
# ⚠️ 下面是【示例值】，不是"你必须照抄的值"。
#    每一项都写明了「可填什么」，请按自己的需要改。
#    下面给的都是 config.py 里的【默认值】—— 也就是说你可以直接全部删掉，
#    行为完全一样（默认值会自动生效）。
# ============================================================

# 应用名。任意字符串，不要加引号。
APP_NAME=llm-app-engineering

# 运行环境。⚠️ 只能填 dev 或 prod（config.py 里用了 Literal 限制），
# 填别的（如 test）会【直接报错】而不是被忽略。
# ⚠️ 填 prod 时 DEBUG 必须是 false，否则启动报错退出（见下面 DEBUG 那条）
APP_ENV=dev
# 说明：容器部署时 compose 会覆盖成 prod（/docs、/openapi.json 关闭）；
#       本地 `uv run python -m app` 用 dev 才有交互式文档
#       演示容器内 /docs：$env:APP_ENV_CONTAINER="dev"; docker compose up -d

# 调试开关。可填 true / false / 1 / 0 / yes / no（大小写不敏感），
# pydantic 会把它转成真正的布尔值。
# ⚠️ APP_ENV=prod 且 DEBUG=true 时，config.py 的跨字段校验会让进程【启动即退出】——
#    故意不静默改成 false：配置写错要在启动时炸，不能带着 traceback 泄露上线
DEBUG=false

# 监听地址。127.0.0.1 = 只有本机能访问；0.0.0.0 = 所有网络都能访问（生产常用）。
HOST=127.0.0.1

# 监听端口。可填 1 ~ 65535 的整数。
# 注意：这里是【字符串】形式（.env 里一切都是字符串），
#       但 config.py 声明了 port: int，所以会被自动转成整数 8000。
PORT=8000

# 数据库连接串。格式是「方言+驱动://路径」
#   sqlite+aiosqlite:///./app.db  -> 当前工作目录下的 app.db（相对路径，带三个斜杠）
#   换 PostgreSQL 时形如 postgresql+asyncpg://user:pass@host:5432/dbname
# ⚠️ 真值（尤其带密码的连接串）只放 .env，绝不写进这一份
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ===== 上游 LLM 供应商（OpenAI 兼容协议）=====
# 现在接的是 DeepSeek（https://api-docs.deepseek.com/zh-cn/）。
# 换别家只改下面这三行 + 密钥，代码一行都不用动。

# 上游 LLM 的 API Key
#
# ⚠️ 这里是 .env.example，所以【绝不能】放真实密钥 —— 这份文件要提交进 Git。
#    真正要用时，去 .env 里取消下面这行注释并填上自己的 key。
#
# ⚠️ 一个反直觉的细节：不要写成 `LLM_API_KEY=`（等号后面留空）。
#    实测：`LLM_API_KEY=`  → 得到【空字符串 ''】
#         整行注释掉        → 得到【None】
#    两者在 if settings.llm_api_key: 判断里【都会走 False 分支】，
#    但语义不同（'' 是"我填了个空的"，None 是"我没填"），所以推荐直接注释掉。
# LLM_API_KEY=sk-在这里填你自己的密钥

# 上游基础地址。DeepSeek 用不带 /v1 的地址；有些兼容服务要写 .../v1。
# 末尾不要带斜杠。
LLM_BASE_URL=https://api.deepseek.com

# 默认模型名
LLM_MODEL=deepseek-flash

# 单次上游请求的超时时间（秒），LLM 生成较慢，这里不用 5 秒默认值
# 【注意】：这是「每两次读之间最多等多久」，不是总时长
REQUEST_TIMEOUT=30

# 建立连接（DNS + TCP + TLS）的超时时间（秒），可填 0.1 ~ 60
# 【注意】：与 REQUEST_TIMEOUT 分开配的理由 —— 单一值会让「对端连不上」和「模型正在生成」
#   等一样久。连不上应该 3 秒就报错，而不是陪它等完 30 秒（#18）
LLM_CONNECT_TIMEOUT=3.0

# 一次上游调用的【总时长】上限（秒），可填 1 ~ 600 的整数或小数
# 【注意】：它和上面的 REQUEST_TIMEOUT 管的不是同一件事 ——
#   REQUEST_TIMEOUT 是「每次读取之间最多等多久」，管不到「慢速滴答」；
#   上游每隔 25 秒吐一个字，就永远不会触发 REQUEST_TIMEOUT，请求可以无限挂着。
#   这一条才是那种情况的唯一防线（非流式 -> 504；流式 -> STREAM_TIMEOUT 帧）。
# 120 的由来：max_tokens_ceiling=4096，慢模型约 30 tok/s -> 上限约 137s，留余量取 120
# ⚠️ 改大时要注意反向约束：nginx 的 proxy_read_timeout（deploy/nginx.conf，130s）必须【大于】它，
#    否则反代会先掐断，客户端看到的是「连不上」而不是我们精心翻译的 STREAM_TIMEOUT
UPSTREAM_TOTAL_TIMEOUT=120.0

# ===== 服务生命周期（2026-11-17 加，13c-5）=====

# 优雅停机的等待窗口（秒），可填 1 ~ 300
# 收到停止信号后：不再接新请求 -> 等在途请求跑完（最多这么久）-> 再退出
# ⚠️ 精度细节（📎 实测）：写 30.0 能过（被当成整数 30），写 30.7 被拒绝（无法解析成整数）
# ⚠️ 另一回事：代码里把 float 传给 uvicorn 过不了类型检查（Config 注解是 int | None）
# ⚠️ 必须【小于】docker-compose.yml 里的 stop_grace_period（40s），
#    否则 Docker 先发 SIGKILL，窗口形同虚设、日志也拿不到
GRACEFUL_SHUTDOWN_TIMEOUT=30

# ===== 容量与成本护栏（2026-11-04 加）=====
# 它们不是"调优参数"，是防止一个用户拖垮所有人的闸门

# 同一时刻最多允许多少个上游调用在飞
# 【进程级】！用 --workers 4 启动时真实上限 = 这个数 × 4（每个 worker 各有一把锁）
MAX_CONCURRENT_UPSTREAM_CALLS=4

# 抢不到槽位时最多等多久（秒）；等不到就回 503 + Retry-After
# 设太大 -> 被挡的请求一直占着 socket 和内存
UPSTREAM_QUEUE_TIMEOUT=1.0

# 服务端允许的 max_tokens 上限（可配范围 1 ~ 32768）
#   客户端要得比这个多 -> 拒绝（400），不是悄悄改成这个数
#   客户端没指定     -> 发这个数当默认值
# 上界 32768 是【成本预算】不是技术上限：📎 输出 $1.20/1M tokens -> 32768 ≈ $0.039/请求
#   模型本身支持 384K=393216（≈ $0.47/请求），故意远低于它
MAX_TOKENS_CEILING=4096

# ===== 每用户速率限制（2026-11-18 加，13d-4）=====
# 目的不是"防止系统过载"（那是上面的闸门），而是「防止一个用户把账号余额刷爆」

# 每个【用户】每分钟允许的请求数（持续速率），可填 1 ~ 100000
# ⚠️ 按 user.id 计，不按 key 计 —— 否则"多开几把 key"就等于把配额翻倍
# ⚠️ 压测时必须放大它，否则测到的是限流器而不是容量（📎 25 个请求就撞 429）
RATE_LIMIT_PER_MINUTE=60

# 桶容量 = 允许的瞬时突发，可填 1 ~ 10000
# 它不改变长期速率，只决定「能不能一口气打出去」
RATE_LIMIT_BURST=20

